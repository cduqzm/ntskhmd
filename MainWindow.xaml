<Window x:Class="ValCC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ValCC"
        Title="valcc"
        Width="940"
        Height="660"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="icons/valcc.ico"
        Background="{StaticResource BackgroundBrush}"
        BorderBrush="{StaticResource LinkBorderBrush}"
        BorderThickness="1"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource MonoFont}"
        FontSize="{StaticResource TextFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Canvas x:Name="StarCanvas" IsHitTestVisible="False" UseLayoutRounding="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="76"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource LinkBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="24,0,10,0">
                    <TextBlock Text="valcc" VerticalAlignment="Center" Style="{StaticResource LogoText}" />
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Content="−" Style="{StaticResource WindowButton}" Click="MinimizeButton_Click" />
                        <Button Content="✕" Style="{StaticResource CloseButton}" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="24,14"
                    BorderBrush="{StaticResource LinkBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText"
                               Margin="0,0,24,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource StatusText}"
                               Text="connecting…" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ToggleButton x:Name="BackupsButton"
                                      Content="backups"
                                      Style="{StaticResource ToolButton}"
                                      Click="BackupsButton_Click" />
                        <Button x:Name="RefreshButton"
                                Margin="8,0,0,0"
                                Content="refresh"
                                Style="{StaticResource ToolButton}"
                                Click="RefreshButton_Click" />
                        <Button x:Name="SaveButton"
                                Margin="8,0,0,0"
                                Content="save"
                                IsEnabled="False"
                                Style="{StaticResource AccentToolButton}"
                                Click="SaveButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="BodyGrid" Grid.Row="2" Margin="24,24,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="profiles" Style="{StaticResource LabelText}" />
                    <ListBox x:Name="ProfileList"
                             Grid.Row="1"
                             Margin="0,4,0,0"
                             Style="{StaticResource LinkList}"
                             SelectionChanged="ProfileList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Grid x:Name="EditorPanel" Grid.Column="2" IsEnabled="False" Style="{StaticResource DimWhenDisabled}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Grid>
                            <TextBlock x:Name="PrimaryLabel" Text="primary outline" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="PrimaryZoomText" HorizontalAlignment="Right" Style="{StaticResource LabelText}" />
                        </Grid>
                        <Border Margin="0,8,0,0" BorderBrush="{StaticResource LinkBorderBrush}" BorderThickness="1">
                            <Canvas x:Name="PrimaryPreview"
                                    Height="150"
                                    Background="{StaticResource PreviewWallBrush}"
                                    ClipToBounds="True"
                                    RenderOptions.EdgeMode="Aliased"
                                    SizeChanged="Preview_SizeChanged" />
                        </Border>
                        <local:ColorPicker x:Name="PrimaryPicker" Margin="0,14,0,0" ColorChanged="PrimaryPicker_ColorChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock x:Name="AdsLabel" Text="ads outline" Style="{StaticResource LabelText}" />
                            <TextBlock x:Name="AdsZoomText" HorizontalAlignment="Right" Style="{StaticResource LabelText}" />
                        </Grid>
                        <Border Margin="0,8,0,0" BorderBrush="{StaticResource LinkBorderBrush}" BorderThickness="1">
                            <Canvas x:Name="AdsPreview"
                                    Height="150"
                                    Background="{StaticResource PreviewWallBrush}"
                                    ClipToBounds="True"
                                    RenderOptions.EdgeMode="Aliased"
                                    SizeChanged="Preview_SizeChanged" />
                        </Border>
                        <local:ColorPicker x:Name="AdsPicker" Margin="0,14,0,0" ColorChanged="AdsPicker_ColorChanged" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="BackupsPanel" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource DimWhenDisabled}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="backups" VerticalAlignment="Center" Style="{StaticResource LabelText}" />
                        <Button Content="open folder"
                                HorizontalAlignment="Right"
                                MinHeight="0"
                                Padding="0,2"
                                FontSize="{StaticResource TinyFontSize}"
                                Style="{StaticResource DimLinkButton}"
                                Click="OpenFolderButton_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="NoBackupsText"
                                       Margin="0,12,0,0"
                                       Style="{StaticResource NoteText}"
                                       Text="no backups yet. one is written before every save and every restore."
                                       Visibility="Collapsed" />
                            <ItemsControl x:Name="BackupList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border MinHeight="44" Padding="0,0,16,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Number}" Style="{StaticResource IndexText}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding DisplayName}" />
                                                <Button Grid.Column="2"
                                                        Content="restore"
                                                        Style="{StaticResource DimLinkButton}"
                                                        Click="RestoreButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="3"
                    Padding="24,13"
                    BorderBrush="{StaticResource LinkBorderBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource NoteText}"
                           Text="editing this profile in the in-game crosshair menu may reset the outline to black." />
            </Border>

            <Grid x:Name="DialogOverlay"
                  Grid.RowSpan="4"
                  Background="{StaticResource BackdropBrush}"
                  Visibility="Collapsed">
                <Border Width="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="20"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource LinkBorderBrush}"
                        BorderThickness="1"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <StackPanel>
                        <Grid>
                            <TextBlock x:Name="DialogTitle" VerticalAlignment="Center" Style="{StaticResource DialogTitleText}" />
                            <Button Margin="0,-10,-12,-10"
                                    HorizontalAlignment="Right"
                                    Content="✕"
                                    Style="{StaticResource CloseButton}"
                                    Click="DialogCancelButton_Click" />
                        </Grid>
                        <TextBlock x:Name="DialogMessage" Margin="0,14,0,0" Style="{StaticResource DialogMessageText}" />
                        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="DialogCancelButton"
                                    Content="cancel"
                                    Style="{StaticResource ToolButton}"
                                    Click="DialogCancelButton_Click" />
                            <Button x:Name="DialogConfirmButton"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource AccentToolButton}"
                                    Click="DialogConfirmButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
